// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenderEmployeeEnum {
  Masculino
  Feminino
  Outro
}

enum CargoEmployeeEnum {
  Prefeito
  Secretario
  Diretor
  Tecnico
  Coordenador
}

model Employee {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  username String @unique
  email    String @unique
  password String

  fullName       String
  dateOfBirth    DateTime
  gender         GenderEmployeeEnum @default(Outro)
  phone          String
  cargo          CargoEmployeeEnum  @default(Secretario)
  expirationDate DateTime

  @@map("employees")
}

enum StatusTaskEnum {
  Fazer
  Andamento
  Concluida
  Expirada
}

enum PriorityTaskEnum {
  Baixa
  Media
  Alta
  Urgente
}

model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  missionTask     String
  descriptionTask String
  deadlineTask    DateTime
  statusTask      StatusTaskEnum   @default(Fazer)
  priorityTask    PriorityTaskEnum @default(Baixa)

  @@map("tasks")
}

enum StatusMarkEnum {
  Agendada
  Reagendada
  Adiada
  Encerrada
  Cancelada
}

model Mark {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  motiveMark      String
  descriptionMark String
  localMark       String
  prazoMark       DateTime
  statusMark      StatusMarkEnum @default(Agendada)

  @@map("marks")
}

model Department {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  nameDepartment   String
  sectorDepartment String

  @@map("departments")
}
