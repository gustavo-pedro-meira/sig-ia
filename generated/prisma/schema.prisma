generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para definir o gênero do funcionário
enum Gender {
  Male
  Female
  Other
}

// Enum para definir o cargo do funcionário
enum Position {
  Cabinet
  Secretary
  Technician1
  Technician2
  Technician3
}

// Modelo que representa um funcionário no sistema
model Employee {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  username String @unique
  email    String @unique
  password String

  fullName       String
  dateOfBirth    DateTime
  gender         Gender   @default(Other)
  phone          String
  position       Position @default(Secretary)
  expirationDate DateTime

  @@map("employees")
}

// Enum para definir o status de uma tarefa
enum TaskStatus {
  ToDo
  InProgress
  Completed
  Expired
}

// Enum para definir a prioridade de uma tarefa
enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

// Modelo que representa uma tarefa no sistema
model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  title       String
  description String
  deadline    DateTime
  status      TaskStatus   @default(ToDo)
  priority    TaskPriority @default(Low)

  @@map("tasks")
}

// Enum para definir o status de um compromisso
enum AppointmentStatus {
  Scheduled
  Rescheduled
  Postponed
  Closed
  Cancelled
}

// Modelo que representa um compromisso/agendamento no sistema
model Appointment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  reason      String
  description String
  location    String
  deadline    DateTime
  status      AppointmentStatus @default(Scheduled)

  @@map("appointments")
}

// Modelo que representa um departamento no sistema
model Department {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name   String
  sector String

  @@map("departments")
}
