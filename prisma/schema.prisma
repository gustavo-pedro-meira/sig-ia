generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
  Other
}

enum Position {
  Cabinet
  Secretary
  Technician1
  Technician2
  Technician3
}

model Employee {
  id String @id @default(uuid())
  createdAt DateTime @default(now())

  username String @unique
  email String @unique
  password String

  fullName String
  dateOfBirth DateTime
  gender Gender @default(Other)
  phone String
  position Position @default(Secretary)
  expirationDate DateTime

  tasks Task[] @relation("EmployeeTasks")
  appointments Appointment[] @relation("EmployeeAppointments")

  tasksResponsible Task[] @relation("EmployeeTasksResponsible")
  appointmentsResponsible Appointment[] @relation("EmployeeAppointmentsResponsible")

  // Relação com Departamento
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  @@map("employees")
}

enum TaskStatus {
  ToDo
  InProgress
  Completed
  Expired
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

model Task {
  id String @id @default(uuid())
  createdAt DateTime @default(now())

  title String
  description String
  deadline DateTime
  status TaskStatus @default(ToDo)
  priority TaskPriority @default(Low)

  hour Int @default(0)
  minute Int @default(0)

  userId String?
  employee Employee? @relation("EmployeeTasks", fields: [userId], references: [id])

  userIdResponsible String?
  employeeResponsible Employee? @relation("EmployeeTasksResponsible", fields: [userIdResponsible], references: [id])

  @@map("tasks")
}

enum AppointmentStatus {
  Scheduled
  Rescheduled
  Postponed
  Closed
  Cancelled
}

model Appointment {
  id String @id @default(uuid())
  createdAt DateTime @default(now())

  reason String
  description String
  location String
  deadline DateTime
  status AppointmentStatus @default(Scheduled)

  hour Int @default(0)
  minute Int @default(0)

  userId String?
  employee Employee? @relation("EmployeeAppointments", fields: [userId], references: [id])

  userIdResponsible String?
  employeeResponsible Employee? @relation("EmployeeAppointmentsResponsible", fields: [userIdResponsible], references: [id])

  @@map("appointments")
}

model Department {
  id String @id @default(uuid())
  createdAt DateTime @default(now())

  name String
  sector String

  // Relação com Funcionários
  employees Employee[]

  @@map("departments")
}